# Public values are not secrets. Supply verified per-environment values when integrations are configured.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Visit statistics (PostHog, cookieless). The project key starts with phc_; never use a personal API key (phx_).
# Leave empty for no analytics at all. The project must have "Cookieless server hash mode" switched on (docs/observability.md).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional exact https origin; defaults to https://us.i.posthog.com (EU projects: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=
# Error monitoring (Sentry). Empty: no Sentry at all. A DSN can only submit events (docs/observability.md).
NEXT_PUBLIC_SENTRY_DSN=
# Spam check on the forms (Cloudflare Turnstile site key). A site key is public by design. Set it together with TURNSTILE_SECRET_KEY, or leave both empty for no check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Keep private credentials server-side. Never prefix these names with NEXT_PUBLIC_.
# Viewer token for Studio preview (draft mode). Without it /api/draft-mode/enable answers 503 and only published content shows.
SANITY_API_READ_TOKEN=
SANITY_WRITE_TOKEN=
# Random secret shared with the Sanity webhook that calls /api/revalidate (projection {_type, _id}). Required for /api/readiness.
SANITY_REVALIDATE_SECRET=
# Origin of the deployed Studio (e.g. https://your-project.sanity.studio), allowed to show this site in Presentation's iframe (CSP frame-ancestors, together with the Sanity Dashboard https://www.sanity.io that hosts it). It also turns on the click-to-edit links in Studio previews. https only; http://localhost:3333 works in development.
SANITY_STUDIO_ORIGIN=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. BIBO Bay <hello@your-verified-domain>. Without it, acknowledgements wait in the outbox.
RESEND_FROM=
# Optional inbox for replies (removal requests). Leave empty to reply to the sender.
RESEND_REPLY_TO=
# Optional staff inbox for new-signup alerts. Alerts are queued in the outbox even before Resend is configured.
STAFF_NOTIFICATION_EMAIL=
# Random secret, at least 32 characters, that keys the rate-limit hash of client addresses. Leads are not stored without it, and a production build fails with a shorter one.
LEAD_IP_HASH_SECRET=
# Optional hourly cap on emails, applied to EACH message kind on its own (whole number 1-10000, default 60): signup acknowledgement, signup staff alert, order acknowledgement, order staff alert and staff quote each have their own budget (rate-limit buckets send:lead_acknowledgement, send:lead_staff_alert, send:order_acknowledgement, send:order_staff_alert, send:quote), spent by the immediate sends and the outbox worker alike, so one kind can never hold up another. Beyond a kind's cap, signups and orders are still stored and those emails wait in the outbox.
LEAD_ACK_SEND_LIMIT_PER_HOUR=
# Sentry source-map upload at build time (all three together); without the token nothing is uploaded.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Payment providers for quote payment links: a comma-separated list of exact hosts, e.g. pay.example.com,checkout.example.net (no wildcards, no subdomains, no https://). Empty: staff cannot save any quote (every quote needs a payment link). A malformed entry fails the environment check.
PAYMENT_HOST_ALLOWLIST=
# Random secret, at least 32 characters, for the email outbox worker. Vercel Cron sends it as a Bearer token to /api/cron/email-outbox; without it the worker answers 503 and failed emails are not retried. A production build fails with a shorter one.
CRON_SECRET=
# Cloudflare Turnstile secret key, paired with NEXT_PUBLIC_TURNSTILE_SITE_KEY. Empty on both: no check. One without the other, or Cloudflare's test keys in production, makes every form answer 503 and fails the production build.
TURNSTILE_SECRET_KEY=
