# Public values are not secrets. Supply verified per-environment values when integrations are configured.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep private credentials server-side. Never prefix these names with NEXT_PUBLIC_.
# Viewer token for Studio preview (draft mode). Without it /api/draft-mode/enable answers 503 and only published content shows.
SANITY_API_READ_TOKEN=
SANITY_WRITE_TOKEN=
# Random secret shared with the Sanity webhook that calls /api/revalidate (projection {_type, _id}). Required for /api/readiness.
SANITY_REVALIDATE_SECRET=
# Origin of the deployed Studio (e.g. https://your-project.sanity.studio), allowed to show this site in Presentation's iframe (CSP frame-ancestors). https only; http://localhost:3333 works in development.
SANITY_STUDIO_ORIGIN=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. BIBO Bay <hello@your-verified-domain>. Without it, acknowledgements wait in the outbox.
RESEND_FROM=
# Optional inbox for replies (removal requests). Leave empty to reply to the sender.
RESEND_REPLY_TO=
# Optional staff inbox for new-signup alerts. Alerts are queued in the outbox even before Resend is configured.
STAFF_NOTIFICATION_EMAIL=
# Random secret, at least 32 characters, that keys the rate-limit hash of client addresses. Leads are not stored without it, and a production build fails with a shorter one.
LEAD_IP_HASH_SECRET=
# Optional global cap on emails sent straight from the signup form, per hour (positive integer, default 60). Beyond it, signups are still stored and their emails wait in the outbox. Shared with the outbox worker.
LEAD_ACK_SEND_LIMIT_PER_HOUR=
PAYMENT_HOST_ALLOWLIST=
CRON_SECRET=
