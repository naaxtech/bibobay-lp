# Only verified Sanity project and dataset values. No credentials in SANITY_STUDIO_* variables.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Optional; must be a verified preview origin or local Next.js URL.
SANITY_STUDIO_PREVIEW_URL=
# Server-only write token for `npm run seed`; never prefix with SANITY_STUDIO_.
SANITY_WRITE_TOKEN=
